<Window x:Class="SoundSwitchQuick.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSwitchQuick — Настройки"
        Width="540"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WidgetBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Настройки"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,18"
                       Text="Поведение виджета и ваши названия аудиоустройств"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource WidgetBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Запуск и положение"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <CheckBox x:Name="AutostartCheckBox"
                                  Margin="0,14,0,0"
                                  Content="Запускать SoundSwitchQuick вместе с Windows"/>

                        <TextBlock Margin="24,4,0,0"
                                   Text="Работает даже у portable EXE: Windows запускает текущий файл при входе в систему."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10.5"/>

                        <CheckBox x:Name="TopmostCheckBox"
                                  Margin="0,14,0,0"
                                  Content="Держать виджет поверх остальных окон"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource WidgetBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Тема"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="DarkThemeRadio"
                                         GroupName="Theme"
                                         Content="Тёмная"
                                         Margin="0,0,28,0"/>
                            <RadioButton x:Name="LightThemeRadio"
                                         GroupName="Theme"
                                         Content="Светлая"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource WidgetBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Названия устройств"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Margin="0,4,0,12"
                                   Text="Например: «Телевизор», «Мои наушники», «Колонки на столе». Системное имя Windows не меняется."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10.5"/>

                        <StackPanel x:Name="DeviceAliasPanel"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource WidgetBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Ярлык на рабочем столе"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ShortcutStatusText"
                                       Margin="0,4,14,0"
                                       Text="Можно создать ярлык на этот portable EXE."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10.5"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Padding="12,7"
                                Content="Создать ярлык"
                                Click="CreateShortcut_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    MinWidth="96"
                    Padding="14,8"
                    Margin="0,0,8,0"
                    Content="Отмена"
                    Click="Cancel_Click"/>

            <Button Grid.Column="2"
                    MinWidth="112"
                    Padding="14,8"
                    Content="Сохранить"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
