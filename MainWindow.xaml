<Window x:Class="SoundSwitchQuick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSwitch Quick"
        Width="356"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Border x:Name="RootCard"
            Background="{DynamicResource WidgetBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="10"
            MouseEnter="RootCard_MouseEnter"
            MouseLeave="RootCard_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.34"/>
        </Border.Effect>

        <StackPanel x:Name="RootStack">
            <Border x:Name="CollapsedCard"
                    Background="{DynamicResource CardBrush}"
                    CornerRadius="14"
                    Padding="12"
                    Cursor="Hand"
                    MouseEnter="Widget_MouseEnter"
                    MouseLeftButtonDown="CollapsedCard_MouseLeftButtonDown"
                    MouseRightButtonUp="CollapsedCard_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="CurrentGlyph"
                                   Text="🔊"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentName"
                                   Text="Поиск устройства…"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Текущий аудиовыход"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10.5"/>
                    </StackPanel>

                    <TextBlock x:Name="ChevronText"
                               Grid.Column="2"
                               Text="⌄"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border x:Name="ExpandedPanel"
                    Visibility="Collapsed"
                    Margin="0,9,0,0"
                    Background="{DynamicResource PanelBrush}"
                    CornerRadius="14"
                    Padding="10">
                <StackPanel>
                    <Grid Margin="2,0,2,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Куда отправить звук?"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Один клик — и звук переключён"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10.5"/>
                        </StackPanel>

                        <Button x:Name="LayerButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="0,0,6,0"
                                Style="{StaticResource MiniButtonStyle}"
                                Click="LayerButton_Click"
                                ToolTip="Переключить режим окна">
                            <TextBlock x:Name="LayerButtonGlyph" Text="📌"/>
                        </Button>

                        <Button Grid.Column="2"
                                Width="32"
                                Height="32"
                                Margin="0,0,6,0"
                                Content="⚙"
                                Style="{StaticResource MiniButtonStyle}"
                                Click="Settings_Click"
                                ToolTip="Настройки"/>

                        <Button Grid.Column="3"
                                Width="32"
                                Height="32"
                                Content="↻"
                                Style="{StaticResource MiniButtonStyle}"
                                Click="Refresh_Click"
                                ToolTip="Обновить устройства"/>
                    </Grid>

                    <ScrollViewer x:Name="DeviceScrollViewer"
                                  MaxHeight="310"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DeviceButtons"/>
                    </ScrollViewer>

                    <TextBlock x:Name="StatusText"
                               Margin="5,5,5,0"
                               Foreground="{DynamicResource FaintTextBrush}"
                               FontSize="9.5"
                               Text="SoundSwitch Quick"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
